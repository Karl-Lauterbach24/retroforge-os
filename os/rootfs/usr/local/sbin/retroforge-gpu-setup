#!/bin/bash
# Chooses the NVIDIA kernel driver at every boot, so one image runs on a
# GeForce 8800 as well as on an RTX 50. Which proprietary module the image
# carries depends on what DKMS could build for its kernel:
#   open module   (license "Dual MIT/GPL"): Turing and newer   (PCI device id >= 0x1e00)
#   closed module (license "NVIDIA"):       Maxwell up to Ada  (0x1340 <= id < 0x2b00)
# Every other NVIDIA GPU – and every GPU when no proprietary module was built – uses
# nouveau (Mesa NVK/nouveau). Both are blacklisted for autoloading in
# /etc/modprobe.d/retroforge-gpu.conf, so nothing is loaded twice.
set -u
license=$(modinfo -F license nvidia 2>/dev/null || true)
for v in /sys/bus/pci/devices/*/vendor; do
    [[ "$(cat "$v")" == 0x10de ]] || continue
    d=$(dirname "$v")
    [[ "$(cat "$d/class")" == 0x03* ]] || continue          # display controllers only
    dev=$(( $(cat "$d/device") ))
    supported=0
    case "$license" in
        "Dual MIT/GPL") (( dev >= 0x1e00 )) && supported=1 ;;
        NVIDIA)         (( dev >= 0x1340 && dev < 0x2b00 )) && supported=1 ;;
    esac
    if (( supported )) && modprobe nvidia-drm modeset=1 fbdev=1; then
        exit 0
    fi
    modprobe nouveau
    exit 0
done
