[Unit]
Description=RetroForge first boot (userdata partition, defaults)
DefaultDependencies=no
After=local-fs-pre.target systemd-udev-settle.service
Before=local-fs.target retroforge.service
ConditionPathExists=!/var/lib/retroforge/firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/retroforge-firstboot
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
